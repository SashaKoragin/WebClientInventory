{
  "compilerOptions": {
    "target": "es5",
    "module": "es2015",
    "moduleResolution": "node",
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [
      "es2015",
      "dom"
    ],
    "noImplicitAny": false,
    "types": [
      "node",
      "jasmine"
    ],
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "./node_modules"
  ],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "enableIvy": false,
  }
}